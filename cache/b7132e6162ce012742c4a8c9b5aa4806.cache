{"expiry":1773560284,"data":[{"id":27,"category_id":3,"name":"3x KIWI","slug":"3-pack-kiwi-slices","description":"A trio of our premium tangy and refreshing dehydrated Kiwi slices. Perfect for stocking up on your favorite tart treat.","ingredients":"[\"Kiwi\"]","nutritional_info":"{\"Per 100 g\":\"\",\"Energy\":\"320 kcal\",\"Protein\":\"3.1 g\",\"Carbohydrate\":\"75 g\",\"Total Sugars\":\"46 g\",\"Total Fat\":\"1.1 g\",\"Dietary Fiber\":\"14.5 g\",\"Sodium\":\"6 mg\"}","weight":"0.075","shelf_life":"6 months","storage_instructions":"Store in cool and dry place.","image":"assets\/images\/products\/prod_698dce570f3af.jpeg","bg_color":"","price":"320.00","original_price":"480.00","discount_percentage":0,"stock":15,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"India","created_at":"2026-02-11 22:24:18","updated_at":"2026-03-02 22:03:16"},{"id":25,"category_id":5,"name":"Alle hachi (200g)","slug":"alle-hachi","description":"Alle hachi have a mild, subtle flavour that blends effortlessly into cooked dishes. Traditionally sun-dried, it softens on cooking and absorbs spices beautifully, making it ideal for light curries, rice-based meals, and slow-cooked dishes. Naturally light and fibre-rich, it adds balance without overpowering the dish.","ingredients":"[\"Sun-dried Bottle Gourd\"]","nutritional_info":"{\"Per 100 g\":\"\",\"Energy\":\"320 kcal\",\"Total Carbohydrate\":\"73 g\",\"Total Sugars\":\"32 g\",\"Dietary Fibre\":\"14 g\",\"Protein\":\"13 g\",\"Total Fat\":\"2.5 g\",\"Saturated Fat\":\"0.5 g\",\"Trans Fat\":\"0 g\",\"Sodium\":\"50 mg\"}","weight":"0.200","shelf_life":"Best before 6 months from the date of packaging.","storage_instructions":"Store in cool and dry place.","image":"assets\/images\/products\/prod_698db87659598.jpeg","bg_color":"","price":"249.00","original_price":"349.00","discount_percentage":0,"stock":5,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"India","created_at":"2026-02-11 21:45:27","updated_at":"2026-02-24 15:51:59"},{"id":26,"category_id":5,"name":"Wangan hachi (100g)","slug":"wangan-hachi","description":"Wangan hachi develop a deeper, earthy flavour when cooked. Sun-dried and rehydrated during cooking, it absorbs spices and gravies well, adding body and richness to curries and rice dishes. Naturally high in fibre, it is best enjoyed in slow-cooked or spice-forward preparations.","ingredients":"[\"Sun-dried Eggplant (Brinjal)\"]","nutritional_info":"{\"Per 100 g\":\"\",\"Energy\":\"310 kcal\",\"Total Carbohydrate\":\"68 g\",\"Total Sugars\":\"28 g\",\"Dietary Fibre\":\"22 g\",\"Protein\":\"14 g\",\"Total Fat\":\"2.5 g\",\"Saturated Fat\":\"0.6 g\",\"Trans Fat\":\"0 g\",\"Sodium\":\"30 mg\"}","weight":"0.100","shelf_life":"6 months","storage_instructions":"Store in cool and dry place.","image":"assets\/images\/products\/prod_698db812bff88.jpeg","bg_color":"","price":"120.00","original_price":"200.00","discount_percentage":0,"stock":2,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"India","created_at":"2026-02-11 21:45:27","updated_at":"2026-02-24 15:52:00"},{"id":16,"category_id":3,"name":"3x APPLE","slug":"3-pack-apple","description":"Three packs of our crisp and sweet dehydrated Kashmiri apples. Light, healthy, and naturally sweet.","ingredients":"[\"Apple\"]","nutritional_info":"{\"Per 100 g\":\"\",\"Energy\":\"250 kcal\",\"Protein\":\"1.5 g\",\"Carbohydrate\":\"67 g\",\"Total Sugars\":\"58 g\",\"Total Fat\":\"0.5 g\",\"Dietary Fiber\":\"8.2 g\",\"Sodium\":\"4 mg\"}","weight":"0.045","shelf_life":"6 months","storage_instructions":"0","image":"assets\/images\/products\/prod_698dcea092b52.jpeg","bg_color":"","price":"169.00","original_price":"360.00","discount_percentage":0,"stock":15,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"0","created_at":"2026-01-17 20:17:53","updated_at":"2026-03-02 22:03:29"},{"id":17,"category_id":3,"name":"3x BANANA","slug":"3-pack-banana","description":"Triple the goodness of our soft and chewy dehydrated bananas. No added sugar, just pure fruit energy.","ingredients":"[\"Banana\"]","nutritional_info":"{\"Per 100 g\":\"\",\"Energy\":\"310 kcal\",\"Protein\":\"3.2 g\",\"Carbohydrate\":\"80 g\",\"Total Sugars\":\"43 g\",\"Total Fat\":\"1.0 g\",\"Dietary Fiber\":\"8.3 g\",\"Sodium\":\"4 mg\"}","weight":"0.090","shelf_life":"6 months","storage_instructions":"0","image":"assets\/images\/products\/prod_698dce895985f.jpeg","bg_color":"","price":"220.00","original_price":"360.00","discount_percentage":0,"stock":15,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"0","created_at":"2026-01-17 20:17:53","updated_at":"2026-03-02 22:03:10"},{"id":18,"category_id":3,"name":"Fruit Trio Mix (Apple + Banana + Kiwi)","slug":"3-pack-mix","description":"Taste the full range with one pack each of our Apple Rings, Banana Coins, and Kiwi Slices. The ultimate fruit snack variety.","ingredients":"[\"Apple\",\"Banana\",\"Kiwi\"]","nutritional_info":"{\"Per 100 g (Avg)\":\"\",\"Energy\":\"293 kcal\",\"Protein\":\"2.6 g\",\"Carbohydrate\":\"74 g\",\"Dietary Fiber\":\"10.3 g\",\"Sodium\":\"5 mg\"}","weight":"0.070","shelf_life":"6 months","storage_instructions":"0","image":"assets\/images\/products\/prod_698dcf05cdbd3.jpeg","bg_color":"","price":"239.00","original_price":"250.00","discount_percentage":0,"stock":13,"sku":null,"is_active":1,"is_featured":1,"is_new":0,"is_vegetarian":1,"country_of_origin":"0","created_at":"2026-01-17 20:17:53","updated_at":"2026-03-02 22:03:40"}]}